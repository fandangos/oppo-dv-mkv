#!/bin/sh
# oppo-dv-mkv boot wrapper: /mnt/ubi_boot/bdpprog
# The jailbreak firmware's launcher (/usr/local/bin/bdpprog) runs this file instead of bdpprog.1 when it exists.
# It swaps in the rebuilt resources (subtitle-menu image, audio decoder file), starts the RAM patcher in the
# background, then runs the real player and hands its exit code back to rc5. If the jb_overlay mod was installed
# first, its boot script was saved as /mnt/ubi_boot/bdpprog.prev and is run instead of the player (it starts its own
# copy of the player).
# Fail-safes (each one leaves a stock player):
#  - $D/disable exists                                          -> no patches
#  - 2 boots in a row never reached "healthy" (dvmkv.sh clears $D/bootcount after 90 s) -> no patches for one boot,
#    then they are tried again (two short boots, e.g. switched off within 90 s, must not disable them for good)
#  - player dies abnormally within 120 s of a patched start     -> create $D/disable and reboot
D=${OPPODV_D:-/mnt/ubi_boot/oppo-dv-mkv}
PLAYER=${OPPODV_PLAYER:-/usr/local/bin/bdpprog.1}
PREV=${OPPODV_PREV:-/mnt/ubi_boot/bdpprog.prev}
[ -f $PREV ] && PLAYER=$PREV
# Replacement resources name:md5 - each swapped into /res only if its md5 matches (RAM only: /res is rebuilt at boot)
RES="image_bdp83.bin:44bedb87bacfc5217ec22cffd2b18295 bdpaudec.db:31b1901fc4114ea4911ff04757959651"
MODS=0
if [ ! -e $D/disable ]; then
  N=$(cat $D/bootcount 2>/dev/null); N=${N:-0}
  case "$N" in *[!0-9]*) N=9;; esac
  if [ "$N" -ge 2 ]; then
    echo "boot $(date) bootcount=$N -> patches skipped for this boot" >> $D/wrapper.log
    rm -f $D/bootcount; sync
  else
    echo $((N+1)) > $D/bootcount; sync
    MODS=1
    if [ -L /res ] && [ -z "$OPPODV_D" ]; then    # /res -> rootfs: replace by a directory of symlinks
      rm /res && mkdir /res && ln -s /mnt/rootfs_normal/res/* /res/ \
        || { rm -rf /res; ln -s /mnt/rootfs_normal/res /res; }
    fi
    if [ -d /res ] && [ ! -L /res ] && [ -z "$OPPODV_D" ]; then
      for r in $RES; do
        f=${r%%:*}; m=${r#*:}
        [ "$(md5sum $D/$f 2>/dev/null | cut -d' ' -f1)" = "$m" ] && ln -sf $D/$f /res/$f
      done
    fi
    [ -f $D/dvmkv.sh ] && sh $D/dvmkv.sh > $D/dvmkv.log 2>&1 &
  fi
fi
T0=$(cut -d. -f1 /proc/uptime)
$PLAYER "$@"
RC=$?
T1=$(cut -d. -f1 /proc/uptime)
case "$RC" in
  0|2|3|4|5|6|7|9|11) ;;
  *) if [ $MODS = 1 ] && [ $((T1-T0)) -lt 120 ]; then
       touch $D/disable
       echo "boot $(date) player rc=$RC after $((T1-T0))s -> patches disabled, rebooting" >> $D/wrapper.log
       sync; exit 6
     fi;;
esac
exit $RC
